# Doppler Service Token (Not strictly required if using local .env exclusively, but good for reference)
DOPPLER_TOKEN=your_doppler_token_here

# Server Config
PORT=3000
DEBUG=false
PUID=1000
PGID=1000

# Auth Config
JWT_SECRET=super_secret_local_dev_key
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
ALLOWED_GOOGLE_EMAILS=your.email@example.com

# Optional Legacy Auth
MCP_API_KEY=optional_legacy_key

# SSH Config
ALLOWED_SSH_HOSTS=node,synology
